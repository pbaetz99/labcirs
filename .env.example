# LabCIRS configuration for docker compose.
#
# scripts/setup.sh copies this file to .env, fills the empty secrets with random values
# and asks for the SMTP password. Never commit .env.
#
# Rules:
# - One KEY=value per line, no comment after a value.
# - JSON values (lists, objects, true/false, numbers) are written inside single quotes.
# - LABCIRS_<NAME> is read by the app (environment variable before local_config.json
#   before the built-in default). An empty value means "use the default".
# - Yes/no settings accept true/false (any case), yes/no, on/off and 1/0. Anything else stops
#   the start with an error, so LABCIRS_DEBUG=False cannot turn debug pages on by accident.
# - Values that look like JSON are decoded (12345678 becomes a number, not text). Put a
#   password that could be mistaken for JSON into JSON quotes: '"12345678"'.

# ---------------------------------------------------------------------------
# Database (the bundled PostgreSQL service "db")
# ---------------------------------------------------------------------------
POSTGRES_DB=labcirs
POSTGRES_USER=labcirs
# Required. Filled by scripts/setup.sh.
POSTGRES_PASSWORD=
# Password the app uses for the database. Empty means POSTGRES_PASSWORD. Filled by
# scripts/setup.sh with the same value as POSTGRES_PASSWORD. Only differs for an
# external database (then also override LABCIRS_DB_HOST).
LABCIRS_DB_PASSWORD=
# Database host as seen from the app container. Default: db (the bundled service).
LABCIRS_DB_HOST=
# compose.yaml sets LABCIRS_DB_ENGINE (PostgreSQL), LABCIRS_DB_NAME and LABCIRS_DB_USER
# from POSTGRES_DB and POSTGRES_USER. Port of an external database. [5432]
LABCIRS_DB_PORT=

# ---------------------------------------------------------------------------
# Proxy (nginx: TLS, /media, rate limits, security headers)
# ---------------------------------------------------------------------------
# Host name of the site. Port 80 redirects to https://<name>/ (port 443).
LABCIRS_SERVER_NAME=cirs.example.org
# Directory with fullchain.pem and privkey.pem (mounted read-only). Keep it out of git.
TLS_CERT_DIR=./tls
# Directory with the logo and the theme stylesheet, served under /branding/ (read-only).
BRANDING_DIR=./branding
# Published ports on the host.
HTTP_PORT=80
HTTPS_PORT=443
# Address of the app as seen from the proxy.
APP_UPSTREAM=app:8000
# Rate limits, only for POST requests. The first two are global (no IP address is used),
# the login limit is per client address and only kept in memory.
# Code check (.../search/)
RATE_CODES=30r/m
# New incident and new comment
RATE_WRITES=10r/m
# Login (/login/ and /admin/login/)
RATE_LOGIN=10r/m

# ---------------------------------------------------------------------------
# gunicorn (app container)
# ---------------------------------------------------------------------------
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3

# ---------------------------------------------------------------------------
# Required app settings
# ---------------------------------------------------------------------------
# Filled by scripts/setup.sh. Keep it secret and never change it on a running system
# (it invalidates sessions and password reset links).
LABCIRS_SECRET_KEY=
# Host names the site answers to.
LABCIRS_ALLOWED_HOSTS='["cirs.example.org"]'
# Languages of the interface. The first one is the default (see LABCIRS_LANGUAGE_CODE).
# Example with German: '{"de": "Deutsch", "en": "English"}'
LABCIRS_LANGUAGES='{"en": "English"}'
# Languages of the content translations (parler), same codes as above.
# Example with German: '["de", "en"]'
LABCIRS_PARLER_LANGUAGES='["en"]'

# ---------------------------------------------------------------------------
# Optional app settings (empty means the default in brackets)
# ---------------------------------------------------------------------------
# true if the proxy sets X-Forwarded-Proto, which the bundled nginx does. [false]
LABCIRS_BEHIND_PROXY=true
# Only false for testing without https. [true]
LABCIRS_SESSION_COOKIE_SECURE=true
# Origins that may send POST requests, including the scheme. Needed only if the site is
# reached on a non-standard port or through another host name. [[]]
LABCIRS_CSRF_TRUSTED_ORIGINS='["https://cirs.example.org"]'
# Development only, never true in production. [false]
LABCIRS_DEBUG=
# Language of the interface if the browser sends none. [first language of LABCIRS_LANGUAGES]
LABCIRS_LANGUAGE_CODE=
# Language of content translations to fall back to. [en]
LABCIRS_PARLER_DEFAULT_LANGUAGE_CODE=
# true: all languages of LABCIRS_PARLER_LANGUAGES are mandatory. [true]
LABCIRS_ALL_LANGUAGES_MANDATORY_DEFAULT=
# Time zone, e.g. Europe/Berlin. [UTC]
LABCIRS_TIME_ZONE=
# Only if the site is not served from the root of the host. The bundled proxy serves the
# root, so leave it empty. []
LABCIRS_ROOT_URL=
# Name of the organization: word mark in the header (without a logo), footer and page titles. [LabCIRS]
LABCIRS_ORGANIZATION=
# Name in page title, header, admin and footer. [LabCIRS]
LABCIRS_SITE_NAME=
# Base address for the plain-text address in mails to reporters, e.g. https://cirs.example.org. []
LABCIRS_SITE_URL=
# true: the reporting form asks for consent to publish, false: incidents are always
# candidates for publication (the QM decides). [true]
LABCIRS_ASK_PUBLICATION_CONSENT=
# Days after which a report that is still "new" counts as without processing in the QM area. [14]
LABCIRS_QM_OVERDUE_DAYS=
# Smallest number that print view and CSV of the evaluations show; a smaller number above 0 appears
# as "< n". Whole number, at least 1. [3]
LABCIRS_REPORT_MIN_CELL=
# Folder with the file "letzte-sicherung" that your backup script writes after each backup that
# worked (name and size of the backup file); the admin start page shows from it when the last backup
# was made. Mount the folder read-only into the app container, e.g. /backup-status (see
# docs/configuration.md). Empty: no backup status is set up. []
LABCIRS_BACKUP_STATUS_DIR=
# Logo in the header, e.g. /branding/logo.svg. Empty: the organization name. []
LABCIRS_LOGO_URL=
# Extra stylesheet that overrides the colour tokens, e.g. /branding/theme.css. []
LABCIRS_THEME_CSS_URL=
# Footer links, shown only when set. []
LABCIRS_IMPRINT_URL=
LABCIRS_PRIVACY_URL=
# Source code link in the footer (AGPL). [address of the LabCIRS fork]
LABCIRS_SOURCE_URL=

# ---------------------------------------------------------------------------
# Mail (password reset for QM and admins, mails to reporters)
# ---------------------------------------------------------------------------
# Sender address. Required for password reset, e.g. cirs@example.org. Without it the reporting
# form does not offer the optional e-mail address for notifications. []
LABCIRS_DEFAULT_FROM_EMAIL=
# [localhost]
LABCIRS_EMAIL_HOST=
# [25]
LABCIRS_EMAIL_PORT=
LABCIRS_EMAIL_HOST_USER=
# Asked for by scripts/setup.sh (not shown, not stored anywhere else).
LABCIRS_EMAIL_HOST_PASSWORD=
# STARTTLS (usually port 587) or implicit TLS (usually port 465), not both. [false]
LABCIRS_EMAIL_USE_TLS=
LABCIRS_EMAIL_USE_SSL=
# Seconds to wait for the mail server. A notification that fails or times out is logged and
# does not stop the report. [10]
LABCIRS_EMAIL_TIMEOUT=
