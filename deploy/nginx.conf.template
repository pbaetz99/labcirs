# nginx configuration of the proxy service. The nginx image renders this file with envsubst:
# ${VARIABLES} come from the container environment (see compose.yaml), $nginx_variables stay.
#
# Logs: no client address, no user agent and no query string (a search term can be a name). The
# only use of an address is the key of the login limit, which lives in memory and is never written.

log_format anon '$time_local "$request_method $uri" $status $body_bytes_sent';
# nginx writes the client address to the error log on levels below crit (e.g. rate limits)
error_log /dev/stderr crit;
# No version in the Server header and in nginx's own error pages (port 80 and 443)
server_tokens off;

# Rate limits count only POST requests, an empty key is not limited. The first two limits are
# global (one key for the whole site), the login limit is per address.
map $request_method $post_key  { POST $server_name;        default ""; }
map $request_method $login_key { POST $binary_remote_addr; default ""; }
limit_req_zone $post_key  zone=codes:1m  rate=${RATE_CODES};
limit_req_zone $post_key  zone=writes:1m rate=${RATE_WRITES};
limit_req_zone $login_key zone=login:1m  rate=${RATE_LOGIN};
limit_req_status 429;

upstream labcirs_app {
    server ${APP_UPSTREAM};
}

# access_log in each server block: a directive on the http level would come on top of the
# access_log of the image's nginx.conf, which logs the client address and the user agent.
server {
    listen 80;
    server_name ${LABCIRS_SERVER_NAME};
    access_log /dev/stdout anon;
    return 301 https://${LABCIRS_SERVER_NAME}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${LABCIRS_SERVER_NAME};
    access_log /dev/stdout anon;

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;

    # 10 MB photos plus the rest of the form
    client_max_body_size 12m;

    # add_header only here: a location with its own add_header drops all of these.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The app gets no address: nginx adds none, and headers a client sends are dropped (an empty
    # value is not passed on).
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_set_header Forwarded "";
    # Django sets these two as well, keep one copy
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;

    # The paths follow cirs/urls.py.
    # Code check
    location ~ ^/incidents/.+/search/$ {
        limit_req zone=codes burst=10 nodelay;
        proxy_pass http://labcirs_app;
    }
    # New incident, new comment
    location ~ ^/incidents/.+/(create/|[0-9]+/)$ {
        limit_req zone=writes burst=5 nodelay;
        proxy_pass http://labcirs_app;
    }
    location ~ ^/(login|admin/login)/$ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://labcirs_app;
    }

    location /media/ {
        alias /srv/media/;
    }
    location /branding/ {
        alias /srv/branding/;
    }

    location / {
        proxy_pass http://labcirs_app;
    }
}
